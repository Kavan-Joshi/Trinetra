# === Trinetra — Environment Configuration ===
# Copy this file to ".env" and fill in your grid credentials.

# Simulator
TRINETRA_SIM_SPEED=20
TRINETRA_JWT_SECRET=dev-secret-change-in-production

# External live camera grid (cctv.corp8.cloud)
# Set these to consume the real grid; leave blank for simulator-only mode.
TRINETRA_GRID_EMAIL=kavanjoshi890@gmail.com
TRINETRA_GRID_PASSWORD=9WXY-ST7Y-C5E9
# TRINETRA_GRID_CATALOGUE_URL=https://cctv.corp8.cloud/cameras.json
# TRINETRA_GRID_RTSP_HOST=103.250.160.189:8554
# TRINETRA_GRID_HLS_BASE=https://cctv.corp8.cloud
# TRINETRA_GRID_WHEP_HOST=103.250.160.189:8889

# Streamer: "sim" (test pattern) or "live" (pull real RTSP)
TRINETRA_STREAMER_MODE=live

# Seeder: false = skip sim cameras (use real grid only)
TRINETRA_SEED_SIM_CAMERAS=false

# Face detection: true = InsightFace ArcFace enabled (CPU-heavy but accurate)
TRINETRA_FACE_DETECTION=true
